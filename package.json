{
  "name": "crm-sst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "demo": "tsx scripts/demo.ts",
    "dev:demo": "node scripts/dev-demo.mjs",
    "app:dev": "node scripts/app-dev.mjs",
    "app:instalador": "node scripts/empacotar.mjs",
    "app:publicar": "node scripts/publicar.mjs",
    "app:icone": "electron scripts/gerar-icone.cjs"
  },
  "build": {
    "appId": "com.camilocaos.crmsst",
    "productName": "CRM SST",
    "electronVersion": "45.1.0",
    "directories": {
      "app": "desktop",
      "output": "instalador",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "icone.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "camilocaos",
        "repo": "crmsst",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "CRM-SST-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM SST",
      "uninstallDisplayName": "CRM SST",
      "language": "1046",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "docx": "^9.15.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true,
    "electron-winstaller": false
  }
}

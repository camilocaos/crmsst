# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/desktop/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production (exceto o ícone do app desktop)
/build/*
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# app desktop gerado (o instalador é distribuído à parte)
/instalador/
/instalador-teste/
# app instalado dentro da pasta do projeto (não versionar)
/CRM SST/

# dados locais (bancos SQLite, testes) nunca vão pro Git
/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# documentos de exemplo com dados reais de clientes (não versionar)
/amostras/
